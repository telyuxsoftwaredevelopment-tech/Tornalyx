# Copiá este archivo a .env y completá con tus credenciales reales.
# NO subas el archivo .env al control de versiones.

DB_HOST=localhost
DB_NAME=tornalyx_db
DB_USER=tornalyx_app
DB_PASS=cambiame_por_una_contrasena_fuerte

# Entorno: development | production
# En production se fuerzan cookies "secure" y otras protecciones.
APP_ENV=development
