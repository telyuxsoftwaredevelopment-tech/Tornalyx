# Copiá este archivo a .env y completá con tus credenciales reales.
# NO subas el archivo .env al control de versiones.

DB_HOST=localhost
# Puerto del servidor MySQL. Local suele ser 3306; TiDB Cloud usa 4000.
DB_PORT=3306
DB_NAME=tornalyx_db
DB_USER=tornalyx_app
DB_PASS=cambiame_por_una_contrasena_fuerte

# ── TLS de la base de datos ───────────────────────────────────────
# Para MySQL gestionado (Aiven, TiDB Cloud, etc.) que exige conexión
# cifrada. En desarrollo local dejalo en 0.
#   DB_SSL=1            activa TLS.
#   DB_SSL_CA           ruta a un bundle de CA, o el certificado PEM
#                       pegado directo (empieza con "-----BEGIN").
#                       Si se deja vacío con DB_SSL=1 se usa el bundle del
#                       sistema (sirve para proveedores con CA pública).
#   DB_SSL_VERIFY=0     desactiva la verificación del cert (no recomendado).
DB_SSL=0
DB_SSL_CA=
DB_SSL_VERIFY=1

# Entorno: development | production
# En production se fuerzan cookies "secure" y otras protecciones.
APP_ENV=development

# ── Envío de correo (2FA por código OTP) ──────────────────────────
# Necesario para el doble factor obligatorio: sin SMTP válido nadie
# puede iniciar sesión. Para Gmail creá una "App Password" (requiere
# tener la verificación en 2 pasos activa en la cuenta de Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=app_password_de_16_caracteres
SMTP_FROM=tu_correo@gmail.com
SMTP_FROM_NAME=Tornalyx

# ── MFA por WhatsApp (Meta WhatsApp Cloud API) ────────────────────
# OPCIONAL: mientras estos valores estén vacíos, el canal WhatsApp no
# aparece y el MFA funciona solo por email. Para habilitarlo necesitás
# una app de Meta con WhatsApp, un número remitente y una plantilla de
# autenticación aprobada.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es
# 'copy' si la plantilla tiene botón de copiar código; 'none' si no tiene.
WHATSAPP_TEMPLATE_BUTTON=copy
WHATSAPP_API_VERSION=v21.0
