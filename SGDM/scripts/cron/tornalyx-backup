# /etc/cron.d/tornalyx-backup
# Instalado por: SGDM/scripts/respaldo.sh --install-cron
# Ejecutado por: backup_tornalyx (usuario de servicio, shell nologin;
# cron no requiere shell interactiva para correr sus tareas).
#
# Actualiza/reemplaza el cronograma ilustrativo de
# docs/primera-entrega/TAREA6-SISTEMAS-OPERATIVOS/analisis-usuarios-sistema.md
# apuntando al script real del repositorio ya desplegado en el servidor.
#
# respaldo.sh bd necesita DB_BACKUP_PASS (usuario DML/DDL/backup separados,
# ver SGDM/database/dcl.sql). Cron no hereda variables de entorno, así que
# se cargan desde /etc/tornalyx/backup.env. Se instala (modo 0600, con la
# plantilla de credentials.d/backup_tornalyx) al correr:
#   sudo ./gestion_usuarios.sh crear backup_tornalyx
# Después hay que reemplazar el placeholder DB_BACKUP_PASS con el password
# real asignado a 'tornalyx_backup'@'localhost' en MySQL.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Backup diario de la base de datos a las 02:00.
0 2 * * * backup_tornalyx . /etc/tornalyx/backup.env && /var/www/tornalyx/SGDM/scripts/respaldo.sh bd >> /var/log/tornalyx/backup.log 2>&1

# Backup semanal de archivos de la aplicación, domingos a las 03:00.
0 3 * * 0 backup_tornalyx /var/www/tornalyx/SGDM/scripts/respaldo.sh archivos >> /var/log/tornalyx/backup.log 2>&1

# Rotación de backups con más de RETENCION_DIAS (14 por defecto), a las 04:00.
0 4 * * * backup_tornalyx /var/www/tornalyx/SGDM/scripts/respaldo.sh rotar >> /var/log/tornalyx/backup.log 2>&1
