# Plantilla ~/.my.cnf para dev_tornalyx — Tornalyx
# Instalada por gestion_usuarios.sh en /home/dev_tornalyx/.my.cnf (modo
# 0600, propietario dev_tornalyx). Es solo una comodidad: el cliente
# 'mysql' lee este archivo automáticamente, así dev_tornalyx no tiene que
# tipear el password cada vez que se conecta a su base tornalyx_dev. No la
# usa ningún script (dev_tornalyx tiene shell interactiva, no es una
# cuenta de servicio).
#
# El password debe coincidir con el asignado a 'tornalyx_dev'@'localhost'
# en MySQL (ver SGDM/database/dcl.sql). gestion_usuarios.sh NO sobrescribe
# este archivo si ya existe, para no pisar un password real ya configurado:
# reemplazar el placeholder de abajo a mano después de la instalación.
[client]
user=tornalyx_dev
password=CAMBIAR_PASSWORD_DEV
